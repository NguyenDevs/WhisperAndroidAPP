<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_settings.xml - Settings Screen Layout
    Migration: settinglayout.xml → activity_settings.xml
    Design: Material Design 3, Dark Mode, NestedScrollView + MaterialCardViews
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:orientation="vertical">

    <!-- ===== TOOLBAR ===== -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.App.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/back"
        app:navigationIconTint="@color/colorOnSurface"
        app:title="@string/settings"
        app:titleCentered="true"
        app:titleTextColor="@color/colorOnSurface">

        <!-- About button (right side) -->
        <ImageButton
            android:id="@+id/btnAbout"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:layout_marginEnd="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="About"
            android:padding="10dp"
            android:src="@drawable/about"
            app:tint="@color/colorOnSurfaceVariant" />
    </com.google.android.material.appbar.MaterialToolbar>

    <!-- Subtle divider below toolbar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/colorDivider" />

    <!-- ===== SCROLLABLE SETTINGS CONTENT ===== -->
    <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="24dp">

        <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="16dp">

            <!-- ===== CARD: NGÔN NGỮ & MÔ HÌNH ===== -->
            <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                    <!-- Section title -->
                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:text="Nhận dạng giọng nói"
                            android:textColor="@color/colorAccent"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1"/>

                    <!-- Ngôn ngữ -->
                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingBottom="12dp">

                        <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/language"
                                android:textColor="@color/colorOnSurface"
                                android:textSize="15sp"
                                android:textStyle="bold"/>

                        <androidx.appcompat.widget.AppCompatSpinner
                                android:id="@+id/spinnerLanguage"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@android:color/transparent"
                                android:minWidth="140dp"/>
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/colorDivider"
                            android:layout_marginBottom="12dp"/>

                    <!-- Mô hình AI -->
                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                        <TextView
                                android:id="@+id/tvModelLabel"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/label_model"
                                android:textColor="@color/colorOnSurface"
                                android:textSize="15sp"
                                android:textStyle="bold"/>

                        <androidx.appcompat.widget.AppCompatSpinner
                                android:id="@+id/spinnerModel"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@android:color/transparent"
                                android:minWidth="140dp"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== CARD: TỐC ĐỘ & CAO ĐỘ GIỌNG ===== -->
            <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                    <!-- Section title -->
                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:text="Giọng đọc (TTS)"
                            android:textColor="@color/colorAccent"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1"/>

                    <!-- Tốc độ đọc -->
                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingBottom="16dp">

                        <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                            <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/label_speech_speed"
                                    android:textColor="@color/colorOnSurface"
                                    android:textSize="15sp"
                                    android:textStyle="bold"/>
                            <TextView
                                    android:id="@+id/tvSpeedValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="50"
                                    android:textColor="@color/colorPrimary"
                                    android:textSize="14sp"
                                    android:textStyle="bold"/>
                        </LinearLayout>

                        <com.google.android.material.slider.Slider
                                android:id="@+id/sliderSpeechSpeed"
                                style="@style/Widget.App.Slider"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:valueFrom="0"
                                android:valueTo="100"
                                android:value="50"
                                android:stepSize="1"/>
                    </LinearLayout>

                    <!-- Divider -->
                    <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/colorDivider"
                            android:layout_marginBottom="16dp"/>

                    <!-- Cao độ giọng -->
                    <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                        <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">
                            <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/label_speech_pitch"
                                    android:textColor="@color/colorOnSurface"
                                    android:textSize="15sp"
                                    android:textStyle="bold"/>
                            <TextView
                                    android:id="@+id/tvPitchValue"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="50"
                                    android:textColor="@color/colorPrimary"
                                    android:textSize="14sp"
                                    android:textStyle="bold"/>
                        </LinearLayout>

                        <com.google.android.material.slider.Slider
                                android:id="@+id/sliderSpeechPitch"
                                style="@style/Widget.App.Slider"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:valueFrom="0"
                                android:valueTo="100"
                                android:value="50"
                                android:stepSize="1"/>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== CARD: ĐỊA CHỈ MÁY CHỦ ===== -->
            <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                    <!-- Section title -->
                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="Kết nối máy chủ"
                            android:textColor="@color/colorAccent"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1"/>

                    <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/tilServerIP"
                            style="@style/Widget.App.TextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="@string/label_server_ip">

                        <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etServerIP"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:inputType="textEmailAddress"
                                android:textColor="@color/colorOnBackground"/>
                    </com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ===== CARD: HÀNH ĐỘNG ===== -->
            <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.App.Card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                    <!-- Section title -->
                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:text="Quản lý dữ liệu"
                            android:textColor="@color/colorAccent"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.1"/>

                    <!-- Clear history button -->
                    <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClearHistory"
                            style="@style/Widget.App.Button.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginBottom="10dp"
                            android:text="@string/label_clear_history"
                            app:icon="@android:drawable/ic_menu_delete"
                            app:iconTint="@color/colorError"
                            android:textColor="@color/colorError"
                            app:strokeColor="@color/colorError"/>

                    <!-- Reset button -->
                    <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnReset"
                            style="@style/Widget.App.Button.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:text="@string/label_reset"/>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
